{
  "name": "@chatmaid/sdk",
  "version": "0.2.0",
  "description": "Official JavaScript/TypeScript SDK for the Chatmaid WhatsApp Developers API",
  "license": "MIT",
  "author": "Chatmaid",
  "homepage": "https://developers.chatmaid.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatmaid/js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/chatmaid/js-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chatmaid",
    "whatsapp",
    "whatsapp developers api",
    "sdk",
    "messaging",
    "api"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
